# CloudOS production environment template.
#
# Copy this file to /opt/cloudos/.env (or wherever you keep your stack)
# and fill in the values marked CHANGE_ME. Never commit the rendered
# file — it contains secrets that grant full control over your data.
#
#   cp deploy/.env.example /opt/cloudos/.env
#   vim /opt/cloudos/.env
#
# All values are read by docker-compose.prod.yml. Restart the stack with
# `docker compose --env-file .env -f docker-compose.prod.yml up -d`
# after any change.

# ─────────────────────────────────────────────────────────────────────
# Domain & TLS
# ─────────────────────────────────────────────────────────────────────

# The full HTTPS URL users will type into their browser. Caddy uses
# this for automatic Let's Encrypt provisioning. Must include scheme.
#   Example: https://cloudos.example.com
PUBLIC_URL=https://cloudos.your-domain.com

# Hostname only — same as PUBLIC_URL minus the scheme/path.
#   Example: cloudos.example.com
DOMAIN=cloudos.your-domain.com

# Email Caddy uses with Let's Encrypt for expiry notifications. Use one
# you actually read — it's the only way LE warns you about renewal
# failures before they become outages.
ACME_EMAIL=you@your-domain.com

# Set the CORS allow-origin to your PUBLIC_URL (no trailing slash).
CORS_ORIGIN=https://cloudos.your-domain.com

# ─────────────────────────────────────────────────────────────────────
# Image tag
# ─────────────────────────────────────────────────────────────────────

# Pin to a specific tag for predictable deployments
# (e.g. v0.2.0). Use `latest` only for staging; tagged releases are
# immutable and won't change under you.
CLOUDOS_TAG=latest

# ─────────────────────────────────────────────────────────────────────
# Secrets — generate fresh values BEFORE first boot
# ─────────────────────────────────────────────────────────────────────

# JWT signing key. 32 bytes hex is plenty.
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Postgres superuser password (only used inside the docker network —
# postgres port is NOT exposed to the host in the prod compose file).
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# MinIO root credentials. The server uses these to read/write the
# cloudos-files bucket. Rotate if you ever expose the MinIO console.
MINIO_ROOT_USER=cloudos
MINIO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# ─────────────────────────────────────────────────────────────────────
# Public-instance policy
# ─────────────────────────────────────────────────────────────────────

# Whether anyone can hit POST /api/v1/auth/register. Recommended:
#   - Set to `true` for the very first boot, register your own admin
#     account at https://cloudos.your-domain.com, then flip to `false`
#     and `docker compose up -d` again so no-one else can sign up.
#   - Keep `true` if you intend to run a public multi-tenant instance
#     (in which case you'll also want to add captcha / rate-limiting at
#     the Caddy layer).
ALLOW_REGISTRATION=false

# Comma-separated list of admin emails. Only these accounts can review
# Developer Portal app submissions and access admin endpoints.
ADMIN_EMAILS=you@your-domain.com

# Enable the Terminal app's WebSocket PTY backend? Leave `false` unless
# you understand the implications: a PTY session spawns a real shell
# inside the server container with the server's UID. Anyone with a
# valid login token can run shell commands.
ENABLE_PTY=false
PTY_SHELL=/bin/bash
